{
  "name": "ffdraft-pro",
  "version": "1.0.0",
  "description": "Fantasy Football Draft & Season Assistant — production-grade rewrite",
  "author": "Dave H",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "electron:dev": "npm run build && electron electron/main.js",
    "electron:build": "npm run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "zustand": "latest",
    "papaparse": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/papaparse": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "eslint": "latest",
    "@eslint/js": "latest",
    "typescript-eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.fantasyfootball.draftassistant",
    "productName": "Fantasy Draft Assistant",
    "directories": { "output": "electron-dist" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
